{
  "name": "vikejs-servers-workspace",
  "private": true,
  "version": "0.0.1",
  "description": "Server adapters for Vike",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "release": "pnpm -r --workspace-concurrency=1 run release",
    "release:minor": "pnpm -r --workspace-concurrency=1 run release:minor",
    "release:major": "pnpm -r --workspace-concurrency=1 run release:major",
    "release:commit": "pnpm -r --workspace-concurrency=1 run release:commit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^20.19.43",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.8.0"
}
